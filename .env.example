# Environment Variables Template for Nilgiri House Admin
# Copy this file to .env and fill in your actual values

# ============================================
# VERCEL & DEPLOYMENT
# ============================================
# Generated automatically by Vercel CLI
VERCEL_OIDC_TOKEN=

# ============================================
# SUPABASE DATABASE (Required)
# Get from: https://app.supabase.com → Settings → API
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# JWT AUTHENTICATION (Required)
# Generate with: openssl rand -hex 32
# ============================================
JWT_SECRET=your-very-long-random-secret-key-minimum-32-characters-here

# ============================================
# API CONFIGURATION (Optional)
# ============================================
# Frontend API base URL
VITE_API_URL=http://localhost:3000/api

# Or for production:
# VITE_API_URL=https://your-api.vercel.app/api

# ============================================
# APPS SCRIPT WEB APP (Required for Google Form submissions)
# Get from: script.google.com → Deploy → Web App → Copy URL
#
# Supports multiple deployments, comma-separated, when a community's form is
# owned and deployed by someone other than you. Position 1 (first) is the
# default used for every community unless overridden in
# COMMUNITY_APPS_SCRIPT_INDEX (backend/routes/google-forms.js and
# api/_handlers/google-forms/submit.ts) — currently only "chess" is overridden,
# pointing at position 2.
#
# Single deployment:
#   APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
#
# Multiple deployments (yours, then the chess community owner's):
#   APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec, https://script.google.com/macros/s/THEIR_SCRIPT_ID/exec
# ============================================
APPS_SCRIPT_WEBAPP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec