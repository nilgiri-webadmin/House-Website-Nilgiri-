# Environment Variables Template for Nilgiri House Admin
# Copy this file to .env and fill in your actual values

# ============================================
# VERCEL & DEPLOYMENT
# ============================================
# Generated automatically by Vercel CLI
VERCEL_OIDC_TOKEN=

# ============================================
# SUPABASE DATABASE (Required)
# Get from: https://app.supabase.com → Settings → API
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# JWT AUTHENTICATION (Required)
# Generate with: openssl rand -hex 32
# ============================================
JWT_SECRET=your-very-long-random-secret-key-minimum-32-characters-here

# ============================================
# GOOGLE OAUTH 2.0 (Required for new auth)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# ============================================
# Frontend Client ID (Vite environment variable)
VITE_GOOGLE_CLIENT_ID=

# Backend Client ID (same as above, used server-side)
GOOGLE_CLIENT_ID="your google client id"

# ============================================
# API CONFIGURATION (Optional)
# ============================================
# Frontend API base URL
VITE_API_URL=http://localhost:3000/api

# Or for production:
# VITE_API_URL=https://your-api.vercel.app/api
